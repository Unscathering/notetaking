{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Basalt",
	"version": "0.17.0",
	"identifier": "app.basalt.notes",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Basalt",
				"width": 1280,
				"height": 820,
				"minWidth": 640,
				"minHeight": 420,
				"backgroundColor": "#16171a",
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"nsis"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": [
					"basalt"
				]
			}
		}
	}
}
