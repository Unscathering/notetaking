{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the Basalt window may do: pick a folder, and read and write the notes inside it.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"dialog:allow-open",
		"fs:allow-read-dir",
		"fs:allow-read-text-file",
		"fs:allow-write-text-file",
		"fs:allow-mkdir",
		"fs:allow-exists",
		"fs:allow-rename",
		"fs:allow-remove",
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "**" }]
		}
	]
}
